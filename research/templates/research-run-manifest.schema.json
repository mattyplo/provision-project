{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattyplo/provision-project/blob/main/research/templates/research-run-manifest.schema.json",
  "title": "Research run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "provision",
    "status",
    "platform",
    "prompt",
    "execution",
    "outputs",
    "limitations",
    "verification",
    "effort"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code_citation",
        "issue_url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "code_citation": {
          "type": "string"
        },
        "issue_url": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "operator": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "product",
        "mode",
        "model",
        "model_ids",
        "settings"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_path",
        "version",
        "template_commit_sha",
        "submitted_prompt_path",
        "capture_method"
      ],
      "properties": {
        "template_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "template_commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "submitted_prompt_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "submitted_prompt_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "differences": {
          "type": [
            "string",
            "null"
          ]
        },
        "capture_method": {
          "enum": [
            "pending",
            "contemporaneous",
            "retrospective",
            "not_recorded"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "completed_at",
        "metadata_capture"
      ],
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "metadata_capture": {
          "enum": [
            "pending",
            "contemporaneous",
            "retrospective",
            "not_recorded"
          ]
        },
        "source_restrictions": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_report_path"
      ],
      "properties": {
        "raw_report_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_export_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_failures",
        "manual_retrievals",
        "notes"
      ],
      "properties": {
        "retrieval_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manual_retrievals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ledger_path",
        "audit_path"
      ],
      "properties": {
        "claim_ledger_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "audit_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "effort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup_minutes",
        "execution_minutes",
        "manual_intervention_minutes"
      ],
      "properties": {
        "setup_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "execution_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "manual_intervention_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "prompt": {
            "properties": {
              "submitted_prompt_path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "execution": {
            "properties": {
              "started_at": {
                "type": "string"
              },
              "completed_at": {
                "type": "string"
              }
            }
          },
          "outputs": {
            "properties": {
              "raw_report_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
